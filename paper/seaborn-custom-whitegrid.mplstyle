# .15 = dark_grey
# .8 = light_grey

### Figure
figure.facecolor: white

### Fonts & Text
#text.color: .15
font.size: 8
font.family: sans-serif
font.sans-serif: Myriad Pro, Arial, Liberation Sans, DejaVu Sans, Bitstream Vera Sans, sans-serif

### equations
mathtext.fontset : cm

### Axes
axes.labelcolor: .15
axes.labelsize: 10
axes.titlesize: 10
axes.grid: False
axes.axisbelow: True
axes.facecolor: white
axes.edgecolor: .15
axes.linewidth: 1
axes.labelpad : 1
axes.spines.right: False
axes.spines.top: False

### Legend
legend.frameon: True
legend.numpoints: 1
legend.scatterpoints: 1

### Lines
lines.solid_capstyle: butt

### Ticks
xtick.labelsize: 8
ytick.labelsize: 8
xtick.direction: out
ytick.direction: out
xtick.color: .15
ytick.color: .15
xtick.major.size: 4
ytick.major.size: 4
xtick.minor.size: 3
ytick.minor.size: 3
xtick.labelcolor: .15
ytick.labelcolor: .15
ytick.major.pad : 1
xtick.major.pad : 1

### Grid
grid.linestyle: -
grid.color: .8

### Saving
savefig.dpi: 900
savefig.transparent: True
                          
